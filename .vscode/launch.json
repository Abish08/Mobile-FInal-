{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "NutriNepal - Android Emulator",
            "cwd": "nutri_nepal",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=API_HOST=10.0.2.2"
            ]
        },
        {
            "name": "NutriNepal - Physical Device",
            "cwd": "nutri_nepal",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=API_HOST=192.168.1.67"
            ]
        },
        {
            "name": "nutri_nepal",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "nutri_nepal (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "nutri_nepal (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
